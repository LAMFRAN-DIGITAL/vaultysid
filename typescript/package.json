{
  "name": "@vaultys/id",
  "version": "4.0.0",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "browser": "./dist/browser/vaultysid.min.js",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "browser": "./dist/browser/vaultysid.min.js",
  "types": "./dist/node/index.d.ts",
  "description": "the most advanced decentralised id framework",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:browser",
    "build:node": "rm -fr ./dist && tsc -p tsconfig.json",
    "build:browser": "webpack --config webpack.config.js",
    "prettier": "find src -name \"*.ts\" | xargs prettier --write",
    "test": "mocha ./test/*.test.[jt]s",
    "test:pqc": "mocha ./test/pqc.test.ts ",
    "test:server": "http-server . -p 8080",
    "test:web": "pnpm build:browser && webpack --config webpack.test.config.js && mocha --require tsx test/runner.ts",
    "visualize": "webpack --config webpack.config.js --json > stats.json",
    "test:compatibility:export": "pnpm run build:node && tsx test/interops/compatibility-export.ts",
    "test:compatibility:rust": "cd rust && cargo test --test typescript_compatibility",
    "test:compatibility": "pnpm run test:compatibility:export && npm run test:compatibility:rust",
    "test:backward-compat": "cd test/backward_compat && npm install && npm test",
    "test:backward-compat:setup": "cd test/backward_compat && npm install && npm run setup",
    "test:interops:reverse": "test/interops/run-cross-language-test.sh reverse",
    "test:interops": "test/interops/run-cross-language-test.sh",
    "test:saltpack:vectors": "tsx test/interops/generate-saltpack-vectors.ts",
    "test:saltpack:go": "mocha test/interops/go-saltpack-compatibility.test.ts",
    "test:security:vectors": "tsx test/interops/generate-security-v2-vectors.ts",
    "test:service:vectors": "tsx test/interops/generate-service-identity-vectors.ts",
    "test:channel:vectors": "tsx test/interops/generate-xwing-channel-vectors.ts",
    "test:anchor:vectors": "tsx test/interops/generate-service-anchor-vectors.ts",
    "test:pq:vectors": "tsx test/interops/generate-pq-identity-vectors.ts",
    "test:legacy:vectors": "tsx test/interops/generate-legacy-v3-vectors.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/pbkdf2": "^3.1.2",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vaultys/id_2": "npm:@vaultys/id@2.4.10",
    "@vaultys/id_3": "npm:@vaultys/id@3.0.4",
    "assert": "^2.1.0",
    "baseline-browser-mapping": "^2.11.38",
    "buffer": "^6.0.3",
    "chai": "^6.3.0",
    "crypto-browserify": "^3.12.1",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "express": "^5.3.0",
    "http-server": "^14.1.1",
    "mocha": "^12.0.3",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vm-browserify": "^1.1.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@stricahq/bip32ed25519": "^2.0.0",
    "@vaultys/saltpack": "1.0.0-beta4",
    "cbor": "^10.0.12",
    "tweetnacl": "^1.0.3"
  },
  "packageManager": "pnpm@12.21.0"
}
